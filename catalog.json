{
  "schemaVersion": 1,
  "name": "SPX Extension Hub",
  "updatedAt": "2026-09-04T12:20:02Z",
  "launcher": {
    "url": "https://iggr1.github.io/spx-extension-hub/launcher/"
  },
  "modules": [
    {
      "id": "spx-dock-flow",
      "name": "SPX Dock Flow",
      "description": "Dashboard em tempo real para mesas, motoristas, rotas, carregamento e volumetria por AT.",
      "version": "1.8.11",
      "enabled": true,
      "type": "web_app",
      "entry": "https://iggr1.github.io/spx-extension-hub/modules/spx-dock-flow/",
      "permissions": [
        "storage",
        "cookies",
        "scripting",
        "tabs",
        "webRequest"
      ],
      "hostPermissions": [
        "https://spx.shopee.com.br/*"
      ],
      "capabilities": [
        "tabs.open",
        "storage.get",
        "storage.set",
        "storage.remove",
        "network.fetchBatch",
        "network.connectionStatus",
        "network.clearAuth"
      ],
      "allowedOpenUrls": [
        "https://spx.shopee.com.br/*"
      ],
      "authProfiles": [
        {
          "id": "spx",
          "requestPatterns": [
            "https://spx.shopee.com.br/*"
          ],
          "tabPatterns": [
            "https://spx.shopee.com.br/*"
          ],
          "captureUrlPatterns": [
            "https://spx.shopee.com.br/*"
          ],
          "captureHeaders": [
            "x-sap-ri",
            "x-sap-sec",
            "x-csrftoken",
            "device-id",
            "app"
          ],
          "cookieMappings": [
            {
              "url": "https://spx.shopee.com.br/",
              "cookieName": "csrftoken",
              "headerName": "x-csrftoken"
            },
            {
              "url": "https://spx.shopee.com.br/",
              "cookieName": "spx-admin-device-id",
              "headerName": "device-id"
            }
          ],
          "defaultHeaders": {
            "accept": "application/json, text/plain, */*",
            "app": "FMS Portal"
          },
          "success": {
            "field": "retcode",
            "equals": 0
          },
          "retryWithoutHeaders": [
            "x-sap-ri",
            "x-sap-sec"
          ]
        }
      ],
      "descriptionPdf": "https://iggr1.github.io/spx-extension-hub/modules/spx-dock-flow/descricao.pdf"
    },
    {
      "id": "assistente-de-devolucoes",
      "name": "Assistente de devoluções",
      "description": "Modal de tentativas no recebimento, identificação de AutoAdd e confirmação ou cancelamento de Endereço não encontrado.",
      "version": "1.0.0",
      "enabled": true,
      "type": "user_script",
      "permissions": [
        "storage",
        "tabs",
        "userScripts"
      ],
      "hostPermissions": [
        "https://spx.shopee.com.br/*"
      ],
      "capabilities": [
        "userscripts.status",
        "userscripts.setEnabled"
      ],
      "userScripts": [
        {
          "id": "recebimento-historico",
          "url": "https://raw.githubusercontent.com/iggr1/spx-extension-hub/main/modules/assistente-de-devolucoes/assistente-de-devolucoes.js",
          "matches": [
            "https://spx.shopee.com.br/*"
          ],
          "excludeMatches": [],
          "runAt": "document_idle",
          "world": "MAIN",
          "allFrames": false
        }
      ],
      "descriptionPdf": "https://iggr1.github.io/spx-extension-hub/modules/assistente-de-devolucoes/descricao.pdf"
    }
  ]
}
